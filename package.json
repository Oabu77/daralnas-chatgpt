{
	"name": "daralnas-chatgpt",
	"description": "Complete backend API template using Hono + Chanfana + D1 + Vitest.",
	"cloudflare": {
		"label": "Backend OpenAPI Template",
		"products": [
			"Workers",
			"D1"
		],
		"categories": [
			"storage"
		],
		"docs_url": "https://chanfana.com",
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/1b2805d9-e7fb-4576-5176-6b409e251800/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/cbde46cf-20fa-4548-7f70-1ae8c2f48900/preview",
		"publish": true
	},
	"dependencies": {
		"chanfana": "2.8.3",
		"hono": "4.10.7",
		"openai": "^4.76.1",
		"zod": "3.25.67"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "0.10.11",
		"@types/node": "24.10.1",
		"typescript": "5.9.3",
		"vitest": "3.2.4",
		"wrangler": "4.51.0"
	},
	"private": true,
	"scripts": {
		"auto-connect": "bash scripts/auto-connect.sh",
		"auto-connect:ts": "npx tsx scripts/auto-connect.ts",
		"auto-connect:test": "bash scripts/test-auto-connect.sh",
		"cf-typegen": "wrangler types",
		"deploy": "wrangler deploy",
		"deploy:darcloud": "bash scripts/deploy-darcloud.sh",
		"deploy:pages": "wrangler pages deploy public --project-name=darcloud-pages",
		"dev": "pnpm seedLocalDb && wrangler dev",
		"predeploy": "wrangler d1 migrations apply DB --remote",
		"schema": "npx chanfana",
		"seedLocalDb": "wrangler d1 migrations apply DB --local",
		"setup:domain": "bash scripts/setup-domain.sh",
		"test": "wrangler deploy --dry-run && npx vitest run --config tests/vitest.config.mts"
	}
}
