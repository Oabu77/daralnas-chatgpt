{
  "name": "quranchain-os",
  "version": "1.0.0",
  "description": "A blockchain-based operating system for managing and authenticating Quran data",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "server": "nodemon src/index.js",
    "blockchain": "node src/blockchain-server.js",
    "blockchain:dev": "nodemon src/blockchain-server.js",
    "dev": "concurrently \"npm run server\" \"cd client && npm run dev\"",
    "mesh": "npm run blockchain",
    "mesh-storage": "node src/services/secureMeshStorageBackend.js",
    "test": "jest",
    "test:mesh-storage-security": "jest __tests__/meshStorageSecurity.test.js --runInBand",
    "setup-stripe": "node setup-stripe.js"
  },
  "keywords": [
    "blockchain",
    "quran",
    "authentication",
    "decentralized"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bip39": "^3.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^6.0.1",
    "js-yaml": "^4.1.1",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.13.9",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "sqlite3": "^5.1.7",
    "stripe": "^12.18.0",
    "swagger-ui-express": "^5.0.1",
    "web3": "^1.8.0",
    "winston": "^3.8.2",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "jest": "^29.0.0",
    "nodemon": "^2.0.20",
    "supertest": "^6.3.3",
    "wrangler": "^3.22.0"
  }
}
