# QuranChain-OS Production Environment (EC2)
# Copy to /etc/quranchain/quranchain.env and fill values

NODE_ENV=production
HOST=0.0.0.0
PORT=3000
BLOCKCHAIN_HTTP_PORT=3001
INTERNAL_HOST=127.0.0.1
MAINNET_API=https://api.darcloud.host

PUBLIC_BASE_URL=https://api.darcloud.host
BLOCKCHAIN_PUBLIC_URL=https://chain.darcloud.host
FRONTEND_URL=https://darcloud.host
CORS_ORIGIN=https://darcloud.host

MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/quranchain_prod?retryWrites=true&w=majority
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=https://darcloud.host/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://darcloud.host/checkout/cancel

API_BASE_URL=https://api.darcloud.host
API_KEY=prod-api-key

CF_API_KEY=xxx
CF_API_EMAIL=admin@darcloud.host
CF_ZONE_ID=xxx
CF_ZONE_2_ID=xxx
CF_ACCOUNT_ID=xxx

P2P_PORT=6001
SEED_NODES=node1.fungimesh.net:6001,node2.fungimesh.net:6001
NODE_ID=quranchain-mainnet-node-001
