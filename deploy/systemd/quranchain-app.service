[Unit]
Description=QuranChain-OS Revenue & Main Application
After=network.target

[Service]
Type=simple
User=omar
WorkingDirectory=/var/www/darcloud/quranchain-mesh
ExecStart=/usr/bin/node /var/www/darcloud/quranchain-mesh/revenue-server.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="NODE_ENV=production"
Environment="PORT=3000"

[Install]
WantedBy=multi-user.target
