[Unit]
Description=QuranChain Blockchain Server
After=network.target quranchain-app.service

[Service]
Type=simple
User=omar
WorkingDirectory=/var/www/darcloud/quranchain-mesh
ExecStart=/usr/bin/node /var/www/darcloud/quranchain-mesh/src/blockchain-server.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment="NODE_ENV=production"
Environment="PORT=3001"

[Install]
WantedBy=multi-user.target
