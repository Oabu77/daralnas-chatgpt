# Production Environment Variables for QuranChain-OS
# LIVE PRODUCTION CREDENTIALS

NODE_ENV=production
PORT=3000

# Database Configuration - MongoDB Atlas
MONGODB_URI=mongodb+srv://quranchain_prod:ProdPass2026!@quranchain-prod.cluster.mongodb.net/quranchain_prod?retryWrites=true&w=majority

# Authentication
JWT_SECRET=quranchain-jwt-secret-production-2026-super-secure-key-change-this
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=https://app.quranchain.com

# Web3 Configuration - LIVE MAINNET
ETHEREUM_NETWORK=mainnet
INFURA_PROJECT_ID=1234567890abcdef1234567890abcdef
WEB3_PROVIDER_URL=https://mainnet.infura.io/v3/1234567890abcdef1234567890abcdef

# Logging
LOG_LEVEL=info

# Security
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# LIVE Stripe Configuration
STRIPE_SECRET_KEY=sk_live_1234567890abcdef1234567890abcdef
STRIPE_PUBLISHABLE_KEY=pk_live_1234567890abcdef1234567890abcdef
STRIPE_WEBHOOK_SECRET=whsec_1234567890abcdef1234567890abcdef

# Frontend URL
FRONTEND_URL=https://app.quranchain.com

# API Configuration for Agents
API_BASE_URL=https://api.quranchain.com
API_KEY=quranchain-prod-api-key-2026-secure

# Cloudflare Configuration (DarCloud)
CF_API_KEY=1234567890abcdef1234567890abcdef
CF_API_EMAIL=admin@quranchain.com
CF_ZONE_ID=1234567890abcdef1234567890abcdef
CF_ZONE_2_ID=1234567890abcdef1234567890abcdef
CF_ACCOUNT_ID=1234567890abcdef1234567890abcdef

# P2P Network Configuration (FungiMesh)
P2P_PORT=6001
SEED_NODES=node1.fungimesh.net:6001,node2.fungimesh.net:6001
NODE_ID=quranchain-mainnet-node-001

# QuranChain Mainnet
QURANCHAIN_API_KEY=qc_mainnet_1234567890abcdef
QURANCHAIN_NETWORK=mainnet