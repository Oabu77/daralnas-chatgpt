# ═══════════════════════════════════════════════════════════════════════════════
# QuranChain Pay™ - Environment Variables
# © QuranChain™ | Omar Mohammad Abunadi™
#
# REQUIRED: Copy to .env and fill with REAL production values.
# NO PLACEHOLDERS IN PRODUCTION.
# ═══════════════════════════════════════════════════════════════════════════════

# Application Secret (generate with: openssl rand -hex 32)
SECRET_KEY=

# Database (PostgreSQL)
DATABASE_URL=postgresql://quranchain:password@localhost:5432/quranchain_pay

# Founder Configuration
FOUNDER_ROYALTY_PERCENT=0.025
FOUNDER_USDC_ADDRESS=
FOUNDER_ETH_ADDRESS=
FOUNDER_BTC_ADDRESS=

# Blockchain RPC (Mainnet) - Get from Infura, Alchemy, etc.
ETH_RPC_URL=
POLYGON_RPC_URL=
BASE_RPC_URL=https://mainnet.base.org

# Settlement Private Key (NEVER COMMIT)
# This key must have USDC to pay gas fees
SETTLEMENT_PRIVATE_KEY=

# Stripe (Live Mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ACH Provider (Plaid/Dwolla)
ACH_PROVIDER_API_KEY=
ACH_PROVIDER_URL=

# Server Configuration
HOST=0.0.0.0
PORT=8080
WORKERS=4

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# CORS
CORS_ORIGINS=*
