# Staging Environment Variables
NODE_ENV=staging
PORT=3000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/quranchain_staging?retryWrites=true&w=majority
JWT_SECRET=staging-jwt-secret-change-this
JWT_EXPIRES_IN=7d
CORS_ORIGIN=https://staging.your-domain.com
WEB3_PROVIDER_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
LOG_LEVEL=debug
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500