{
	"compatibility_date": "2025-10-08",
	"main": "src/index.ts",
	"name": "daralnas-chatgpt",
	"account_id": "3bfc21f5baba642160ec706818e3a19f",
	"upload_source_maps": true,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "openapi-template-db",
			"database_id": "26b921d0-3226-485d-a105-dc820a9abdbc"
		}
	],
	"vars": {
		"ENVIRONMENT": "production",
		"AUTO_REPAIR_ENABLED": "true",
		"FUNGI_MESH_ENABLED": "true",
		"DARCLOUD_ENABLED": "true"
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	}
}
